# Application
APP_NAME=Polymarket-M5-Bot
ENVIRONMENT=development
LOG_LEVEL=INFO
DASHBOARD_ACCESS_KEY=polymarket2026

# Trading Mode
PAPER_TRADING=true

# Binance WebSocket & REST
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_URL=https://api.binance.com

# Polymarket API & CLOB
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_CHAIN_ID=137  # Polygon Mainnet
POLYMARKET_PRIVATE_KEY=your_polygon_private_key_here

# PostgreSQL Database
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=bot_password_123
POSTGRES_DB=polymarket_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bot_user:bot_password_123@localhost:5432/polymarket_db

# Redis Cache & Event Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Risk Limits
MAX_POSITION_SIZE_USD=50.0
MAX_DAILY_LOSS_USD=200.0
MIN_EXPECTED_VALUE=0.05  # Min EV threshold (e.g. 5%)
