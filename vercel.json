{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/styles.css",
      "destination": "/app/web/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/app/web/app.js"
    },
    {
      "source": "/(.*)",
      "destination": "/app/web/index.html"
    }
  ]
}
